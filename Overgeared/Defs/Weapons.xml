<?xml version='1.0' encoding='utf-8'?>
<Defs>
  <ThingDef Name="PF_WeaponBase" ParentName="BaseMeleeWeapon_Sharp_Quality" Abstract="True">
    <thingClass>PersonalForge.ForgedWeapon</thingClass>
    <description>A weapon forged from a custom plan. Its blade, guard, grip, pommel and materials determine its appearance and performance.</description>
    <techLevel>Medieval</techLevel>
    <recipeMaker IsNull="True" />
    <smeltable>false</smeltable>
    <equippedAngleOffset>25</equippedAngleOffset>
    <graphicData><texPath>PersonalForge/Parts/head_0_1</texPath><graphicClass>Graphic_Single</graphicClass><drawSize>(1.05,1.05)</drawSize></graphicData>
    <statBases><MaxHitPoints>150</MaxHitPoints><Mass>1.35</Mass><MarketValue>150</MarketValue><WorkToMake>6000</WorkToMake></statBases>
  </ThingDef>
  <ThingDef ParentName="PF_WeaponBase">
    <defName>PF_Sword</defName><label>custom longsword</label>
    <tools><li><label>blade</label><capacities><li>Cut</li></capacities><power>18</power><cooldownTime>2.6</cooldownTime></li></tools>
  </ThingDef>
  <ThingDef ParentName="PF_WeaponBase">
    <defName>PF_Axe</defName><label>custom battle axe</label>
    <tools><li><label>axe blade</label><capacities><li>Cut</li></capacities><power>23</power><cooldownTime>3.1</cooldownTime></li></tools>
  </ThingDef>
  <ThingDef ParentName="PF_WeaponBase">
    <defName>PF_Hammer</defName><label>custom warhammer</label>
    <weaponClasses Inherit="False"><li>Melee</li><li>MeleeBlunt</li></weaponClasses>
    <tools><li><label>hammer head</label><capacities><li>Blunt</li></capacities><power>21</power><cooldownTime>3.0</cooldownTime></li></tools>
  </ThingDef>
  <ThingDef ParentName="PF_WeaponBase">
    <defName>PF_Spear</defName><label>custom spear</label>
    <equippedAngleOffset>65</equippedAngleOffset>
    <tools><li><label>spearhead</label><capacities><li>Stab</li></capacities><power>20</power><cooldownTime>2.8</cooldownTime></li></tools>
  </ThingDef>
  <RecipeDef>
    <defName>PF_ForgeWeapon</defName><label>forge custom weapon</label>
    <workerClass>PersonalForge.ForgeTemplateWorker</workerClass>
    <description>Open the forge customization window, choose parts, materials and patterns, then set a quantity and click Order to add a crafting bill.</description>
    <jobString>Forging a custom weapon.</jobString>
    <workAmount>6000</workAmount><workSpeedStat>GeneralLaborSpeed</workSpeedStat><workSkill>Crafting</workSkill>
    <effectWorking>Smith</effectWorking><soundWorking>Recipe_Smith</soundWorking>
    <researchPrerequisite>Smithing</researchPrerequisite>
    <skillRequirements><Crafting>4</Crafting></skillRequirements>
    <ingredientValueGetterClass>PersonalForge.IngredientValueGetter_Count</ingredientValueGetterClass>
    <ingredients><li><filter><thingDefs><li>Steel</li></thingDefs></filter><count>52</count></li><li><filter><thingDefs><li>WoodLog</li></thingDefs></filter><count>8</count></li></ingredients>
    <fixedIngredientFilter><thingDefs><li>Steel</li><li>WoodLog</li></thingDefs></fixedIngredientFilter>
    <products><PF_Sword>1</PF_Sword></products><useIngredientsForColor>false</useIngredientsForColor>
  </RecipeDef>
</Defs>